# OpenSAM Studio configuration. Copy to `.env.local` and adjust.
# Everything has a working default: with no .env file the app runs in mock AI
# mode using the bundled FFmpeg binaries. Secrets here stay on the server —
# nothing in this file is sent to the browser.

# ─── Storage & limits ──────────────────────────────────────────────────────
# Where uploads, masks, exports and job state are stored.
DATA_DIR=./data
MAX_UPLOAD_MB=500
MAX_VIDEO_DURATION_SECONDS=600
MAX_VIDEO_DIMENSION=4096
# Masks are computed at this max side length (aspect preserved). Use 1024 with SAM 2 on a GPU.
ANALYSIS_MAX_SIZE=512
# Background jobs (tracking, exports) that may run at once.
JOB_CONCURRENCY=2
# Refuse new uploads/exports when free disk space drops below this.
MIN_FREE_DISK_MB=1024

# ─── Background jobs ───────────────────────────────────────────────────────
# memory = jobs run inside the web server (simplest; one process)
# redis  = BullMQ on Redis; run `npm run worker` processes to execute jobs
JOB_BACKEND=memory
REDIS_URL=redis://localhost:6379
JOB_QUEUE_PREFIX=opensam
# Job types this worker process takes (e.g. "segment" on GPU machines).
WORKER_JOB_TYPES=ingest,segment,export
# Redis backend: also run a worker inside the web process (single container).
RUN_WORKERS_IN_WEB=false
JOB_RETENTION_HOURS=168
WORKER_SHUTDOWN_GRACE_MS=25000

# ─── Project metadata ──────────────────────────────────────────────────────
# file     = JSON files in DATA_DIR (default)
# postgres = PostgreSQL (npm run db:import-files copies file-store projects over)
PROJECT_STORE=file
DATABASE_URL=
DATABASE_POOL_SIZE=10

# ─── Media storage ─────────────────────────────────────────────────────────
# local = DATA_DIR only (default)
# s3    = S3 or a compatible service; DATA_DIR becomes a per-machine cache
MEDIA_STORE=local
S3_BUCKET=
S3_REGION=us-east-1
# For MinIO / R2 / other S3-compatible services:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Optional: otherwise the AWS default credential chain is used.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
MEDIA_CACHE_MAX_MB=20480

# ─── Language model (natural language → structured command) ──────────────
# mock  = built-in rule-based parser (no model needed)
# llama = any OpenAI-compatible endpoint serving Llama (Ollama, vLLM, llama.cpp, Together, Groq…)
LLM_PROVIDER=mock
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_MODEL=llama3.1:8b
# Only if your endpoint requires one (kept server-side).
LLAMA_API_KEY=
LLAMA_TIMEOUT_MS=20000
# If Llama is down or returns invalid output, fall back to the built-in parser (flagged in the UI).
LLAMA_FALLBACK_TO_RULES=true

# ─── Segmentation & tracking ───────────────────────────────────────────────
# mock = classical computer vision on the CPU (demo/development quality)
# sam3 = the inference server in ./inference running SAM 3 (MODEL_FAMILY=sam3, GPU)
# sam2 = the same server running SAM 2 (MODEL_FAMILY=sam2, GPU recommended)
SEGMENTATION_PROVIDER=mock
# One server, or a comma-separated pool (each video sticks to one server; failover is automatic).
SAM2_SERVICE_URL=http://localhost:8008
# Must match INFERENCE_API_KEY on the inference server, if set.
SAM2_API_KEY=
SAM2_TIMEOUT_MS=300000
# true = send file paths instead of uploading videos (both machines share DATA_DIR).
SAM2_SHARED_STORAGE=false

# ─── FFmpeg ────────────────────────────────────────────────────────────────
# Optional overrides. By default the bundled ffmpeg-static / @ffprobe-installer
# binaries are used, then whatever is on $PATH.
FFMPEG_PATH=
FFPROBE_PATH=
